# This file tells Git which files shouldn't be added to source control

.DS_Store
.idea
.env
.env.*
dist/
node_modules
storage/

# Rebuildable from sites/ via `npm run db`. The hand-edited columns live in
# tags.csv, which IS committed.
archive.db
archive.db-wal
archive.db-shm

# Output of the sheets export; regenerated, not source.
sheets-output/

# A crawl's capture list while it is still being fetched from CDX, page by page;
# removed once the list is complete.
cdx-pages.json

# Folders of symlinks to sites/'s images, sorted by size and subject; `npm run images`.
image-aliases/

# Guestbook entries: written on the site, so the server holds the only copy. See the
# guestbook section of src/serve.js.
guestbook.db
guestbook.db-wal
guestbook.db-shm
