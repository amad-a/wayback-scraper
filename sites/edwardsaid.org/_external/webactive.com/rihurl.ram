<if variable="mimetype is rpm"><Header name=Content-type value=audio/x-pn-realaudio-plugin><otherwise><Header name=Content-type value=audio/x-pn-realaudio></if><set variable="server" eval="<random separator=+++>siamang.realimpact.net+++bonobo.realimpact.net</random>"><if variable="file"><if not variable="file is "><set variable=file1 eval="<insert encode="none" variable=file>"><for variable=i from=1 to=30><formoutput><if variable=file#i#><define name=url#i#><set variable=sep value=?><insert encode="none" variable=file#i#><if variable=mode><insert encode="none" variable=sep><set variable=sep value=&>mode=<insert encode="none" variable=mode></if><if variable=start><insert encode="none" variable=sep><set variable=sep value=&>start=<insert encode="none" variable=start></if><if variable=end><insert encode="none" variable=sep><set variable=sep value=&>end=<insert encode="none" variable=end></if><if variable=title><insert encode="none" variable=sep><set variable=sep value=&>title=<insert encode="none" variable=title></if><if variable=author><insert encode="none" variable=sep><set variable=sep value=&>author=<insert encode="none" variable=author></if><if variable=copyright><insert encode="none" variable=sep><set variable=sep value=&>copyright=<insert encode="none" variable=copyright></if></define></if></formoutput></for><if variable="proto is pnm"><for variable=i from=1 to=30><formoutput><if variable=file#i#>pnm://#server#/<insert encode="none" name="url#i#"></if></formoutput></for></if><else><for variable=i from=1 to=30><formoutput><if variable=file#i#>rtsp://#server#/<insert encode="none" name="url#i#">
</if></formoutput></for>
--stop--
<for variable=i from=1 to=30><formoutput><if variable=file#i#>pnm://#server#/<insert encode="none" name="url#i#"></if></formoutput></for></else><comment>**end proto if**</comment></if><else>pnm://<insert variable="server">/messages/badurl.rm</else></if><else>pnm://<insert variable="server">/messages/badurl.rm</else>