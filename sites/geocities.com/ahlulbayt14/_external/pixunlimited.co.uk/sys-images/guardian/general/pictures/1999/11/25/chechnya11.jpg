                }

				function OAS_AD(pos) {
                    if (true) {
                        if (typeof(OAS_RICH) !== 'undefined' && OAS_version >= 11) {
                            OAS_RICH(pos);

                            // trigger event to say that content of ad is now readable
                            var event;
                            var adLoad = "ad-load";
                            if (document.createEvent) {
                                event = document.createEvent("HTMLEvents");
                                event.initEvent(adLoad, false, false);
                            } else if (document.createEventObject) {
                                event = document.createEventObject();
                                event.eventType = adLoad;
                            }
                            var slot = document.getElementById(pos);
                            slot.dispatchEvent(event);

                        } else {
                            OAS_NORMAL(pos);
                        }
                    }
				}
					</script>
