            <td height="62"> 
              <div align="center"><font face="Verdana, Arial, Helvetica, sans-serif" size="5" align="center"><b>MSNBC 
                grappling with the words "terror" and "terrorism"</b></font></div>
            </td>
          </tr>
          <tr align="left" valign="top"> 
            <td height="2"> 
              <hr height="1">
            </td>
